# Base de données PostgreSQL — en prod : base locale de l'école, JAMAIS exposée sur Internet
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/bds_ensiie?schema=public"

# Auth.js (NextAuth v5) — phase 3 (générer avec : openssl rand -base64 32)
AUTH_SECRET=""

# API admin — jeton de service partagé avec l'app admin (Vercel), rotatif — phase 5
ADMIN_API_TOKEN=""

# Envoi d'emails : SMTP de l'école OU Resend — phase 3
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BDS ENSIIE <no-reply@bds.iiens.net>"
# RESEND_API_KEY=""

# URL publique du site
APP_URL="http://localhost:3000"

# HelloAsso API v5 — sandbox pour les tests ; organisation à faire vérifier en prod
HELLOASSO_API_BASE="https://api.helloasso.com/v5"
HELLOASSO_CLIENT_ID=""
HELLOASSO_CLIENT_SECRET=""
HELLOASSO_ORG_SLUG=""
HELLOASSO_WEBHOOK_SECRET=""

# Stockage images S3-compatible (UploadThing ou Supabase Storage)
STORAGE_URL=""
STORAGE_KEY=""
STORAGE_SECRET=""
STORAGE_BUCKET=""

# Cotisation BDS — VALEUR FICTIVE tant que le montant n'est pas fixé côté HelloAsso (en centimes)
BDS_COTISATION_CENTS="2000"

# Contact affiché dans le footer
BDS_CONTACT_EMAIL="bds@ensiie.eu"

# Mode de paiement : "mock" (simulation locale, sans HelloAsso) ou "helloasso" (vrai encaissement API v5)
PAYMENT_MODE="mock"

# Boîte mail de dev : les liens de vérification sont listés sur /api/dev/mailbox (jamais active en prod)
DEV_MAILBOX="true"
